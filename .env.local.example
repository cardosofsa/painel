NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional em desenvolvimento, RECOMENDADO em produção.
# É a base dos links enviados por e-mail (confirmação de cadastro e recuperação de senha).
# Sem ela, a URL é deduzida do header da requisição — o que funciona em localhost, mas
# atrás de proxy pode gerar link apontando para o host errado.
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# ---------------------------------------------------------------------------
# Geração de texto por IA (opcional). Sem esta chave o app funciona normalmente
# e os botões de IA simplesmente não aparecem — é também o jeito de desligar o
# recurso sem fazer deploy.
#
# ATENÇÃO: NÃO prefixe com NEXT_PUBLIC_. Ela é lida só no servidor; com o prefixo
# ela iria para o bundle do navegador e qualquer visitante poderia usá-la.
#
# Pegue em https://aistudio.google.com/apikey e configure um limite de gasto no
# console do Google — a cota por conta do app (migração 0024) protege você de um
# usuário, não de um erro de configuração.
# GEMINI_API_KEY=

# Opcional. O padrão é o modelo mais barato que aceita raciocínio mínimo.
# Trocar por um modelo maior encarece cada geração.
# GEMINI_MODEL=gemini-3.5-flash-lite
