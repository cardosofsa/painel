NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional em desenvolvimento, RECOMENDADO em produção.
# É a base dos links enviados por e-mail (confirmação de cadastro e recuperação de senha).
# Sem ela, a URL é deduzida do header da requisição — o que funciona em localhost, mas
# atrás de proxy pode gerar link apontando para o host errado.
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# ---------------------------------------------------------------------------
# Geração de texto por IA (opcional). Sem esta chave o app funciona normalmente
# e os botões de IA simplesmente não aparecem — é também o jeito de desligar o
# recurso sem fazer deploy.
#
# ATENÇÃO: NÃO prefixe com NEXT_PUBLIC_. Ela é lida só no servidor; com o prefixo
# ela iria para o bundle do navegador e qualquer visitante poderia usá-la.
#
# Pegue em https://aistudio.google.com/apikey e configure um limite de gasto no
# console do Google — a cota por conta do app (migração 0024) protege você de um
# usuário, não de um erro de configuração.
# GEMINI_API_KEY=

# Opcional. O padrão é o modelo mais barato que aceita raciocínio mínimo.
# Trocar por um modelo maior encarece cada geração.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Chave-mestra do cofre das chaves de IA que cada conta cadastra (AES-256-GCM, 32 bytes em
# base64). Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Vale também na Vercel. NÃO troque depois de haver IAs cadastradas: as chaves guardadas
# deixam de abrir (e cada conta precisa cadastrar de novo).
# IA_CHAVE_COFRE=

# Assina o cookie de acesso do middleware. Opcional: sem ela, usa IA_CHAVE_COFRE.
# ACESSO_SEGREDO=

# Captcha (Cloudflare Turnstile) no login, cadastro e recuperação. Opcional: sem ela nada muda.
# É a chave PÚBLICA do widget; a secreta vai no painel do Supabase (Auth → Attack Protection).
# Ligue nesta ordem: variável + deploy, e só depois no Supabase (docs/seguranca-login.md).
# Em dev, a chave de teste 1x00000000000000000000AA sempre passa.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Só para aplicar migração pelo script (npm run db:migracao). Não é lida pelo app.
# O token é pessoal e dá acesso de dono a todos os seus projetos: crie em
# supabase.com/dashboard/account/tokens e não suba para a Vercel.
# SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx
# SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# SÓ SERVIDOR. Ignora o RLS: usada apenas por rotas sem usuário logado (cron da Shopee,
# webhooks do Mercado Livre e da cobrança, frete e pedido da vitrine pública). Nunca
# prefixe com NEXT_PUBLIC_. Sem ela, esses recursos ficam desligados.
# SUPABASE_SERVICE_ROLE_KEY=

# Protege /api/cron/shopee (sincronização automática de pedidos).
# CRON_SECRET=

# API da Shopee (docs/shopee-api.md). Sem elas, a importação por planilha continua funcionando.
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# SHOPEE_AMBIENTE=teste   # só para o sandbox; omita em produção
# SHOPEE_HOST=

# API do Mercado Livre (docs/mercadolivre-api.md).
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=
